# Copie para .env (não versionado) e ajuste.
DATABASE_URL=postgres://usuario:senha@localhost:5432/redshield
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Pasta do front compilado (app/dist) para a API servir na mesma origem.
WEB_DIST=../app/dist
SESSAO_DIAS=14
# Usada nos links de e-mail (convite, redefinição de senha).
URL_PUBLICA=http://localhost:3000
# Tentativas por janela nas rotas de login/senha.
LIMITE_LOGIN=10

# E-mail (Resend). Sem a chave, os e-mails só são escritos no log.
RESEND_API_KEY=
EMAIL_REMETENTE=REDSHIELD <onboarding@resend.dev>
# Rotinas diárias (cobranças do mês e avisos). Ligue em UMA instância só.
ROTINAS=0
HORA_DOS_AVISOS=8
# 1 = aplica migrações ao iniciar (padrão: ligado fora de produção). Em produção use `npm run migrar` no deploy.
MIGRAR_NO_INICIO=
# Opcional: conexão com um papel dono do schema, só para migrar (o app usa DATABASE_URL).
MIGRATION_DATABASE_URL=
# Pasta com schema.sql e migrations (padrão: ../db relativo ao código; a imagem Docker define /app/db).
DB_DIR=
